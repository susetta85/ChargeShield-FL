# ChargeShield-FL — Dockerfile.flare
# Immagine base per i container FL (server + client caltech/jpl/office1 +
# admin console) — vedi containerlab/topology.clab.yml.
#
# CORREZIONE 2026-07-31: questo file diceva "server, client, auditor, IDS"
# come se fossero 4 ruoli/servizi distinti — non lo sono. PrivacyAuditor
# (src/auditor/) e ChargingIDS (src/ids/) girano DENTRO al processo server
# NVFLARE (incapsulati in ChargeShieldAggregator, vedi
# nvflare/jobs/chargeshield_poc/app/custom/chargeshield_aggregator.py e
# config_fed_server.json), non come container/servizi di rete separati.
# La vecchia topologia Sprint 5 li descriveva come tali per un design mai
# realmente costruito così — vedi la nota in cima a
# containerlab/topology.clab.yml per i dettagli completi.
#
# Build:
#   docker build -f Dockerfile.flare -t chargeshield-fl:latest .
#
# Note:
#   - NVFLARE 2.7.2 incluso
#   - mTLS gestito da NVFLARE: i certificati sono generati da
#     `nvflare provision` e montati in /workspace/startup/ via
#     Containerlab binds — NON configurati in questo Dockerfile
#   - PyTorch CPU-only (no CUDA): compatibile con OrbStack su Mac
#   - CHARGESHIELD_PROJECT_ROOT=/app (fix 2026-07-31): senza questa variabile,
#     chargeshield_executor.py/chargeshield_aggregator.py non trovano
#     src/config/datasets quando NVFLARE li carica dentro il job deployment —
#     stessa classe di bug già trovata e corretta il 2026-07-24 per
#     `nvflare simulator` (_find_project_root() la richiede esplicitamente,
#     o incappa nello stesso fallimento silenzioso "0 sessioni caricate" già
#     documentato in quel fix). NON verificato in un container reale: nessun
#     ambiente Docker è disponibile nel sandbox che ha scritto questo file —
#     vedi docs/NVFlareIntegration.md per il runbook e cosa verificare al
#     primo avvio reale.

FROM python:3.10-slim

LABEL maintainer="ChargeShield-FL"
LABEL version="0.5.0"
LABEL description="NVFLARE 2.7.2 + PyTorch + ChargeShield-FL"

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ca-certificates \
    iproute2 \
    iputils-ping \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ───────────────────────────────────────────────────────
# nvflare: FL framework + mTLS + provisioning
# torch:   Autoencoder training (CPU-only per compatibilità OrbStack)
# Installa torch da indice PyTorch CPU
RUN pip install --no-cache-dir \
    torch==2.3.1 --index-url https://download.pytorch.org/whl/cpu

# Installa le restanti dipendenze da PyPI
RUN pip install --no-cache-dir \
    nvflare==2.7.2 \
    numpy==1.26.4 \
    scikit-learn==1.5.1 \
    pandas==2.2.2 \
    pyyaml==6.0.2 \
    cryptography==42.0.8

# ── Sorgenti ChargeShield-FL ──────────────────────────────────────────────────
WORKDIR /app
COPY src/ /app/src/
COPY config/ /app/config/

# Aggiunge src/ al PYTHONPATH per gli import (es. from ml.base_ml import ...)
ENV PYTHONPATH="/app/src"

# Fix 2026-07-31 (vedi nota in cima al file): senza questa, _find_project_root()
# in chargeshield_executor.py/chargeshield_aggregator.py non sa dove sia la
# project root dentro il container e fallisce (o carica 0 sessioni in
# silenzio). containerlab/topology.clab.yml la ribadisce per-nodo, ma va
# impostata anche qui per chiunque avvii l'immagine senza passare da
# Containerlab (es. un test rapido con `docker run`).
ENV CHARGESHIELD_PROJECT_ROOT="/app"

# ── Workspace NVFLARE ─────────────────────────────────────────────────────────
# Containerlab monta il workspace provisionato via binds:
#   /workspace/startup/  → start.sh + certificati mTLS (da nvflare provision)
#   /workspace/local/    → configurazione locale del sito
#   /workspace/transfer/ → scambio modelli client ↔ server
RUN mkdir -p /workspace/startup /workspace/local /workspace/transfer

WORKDIR /workspace

# ── Entrypoint ────────────────────────────────────────────────────────────────
# start.sh è generato da nvflare provision e montato via Containerlab.
# Se non presente (container non ancora provisionato) → attende in idle.
CMD ["/bin/bash", "-c", \
     "if [ -f /workspace/startup/sub_start.sh ]; \
      then bash /workspace/startup/sub_start.sh; \
      else echo 'startup/ non trovato — esegui nvflare provision prima del deploy'; \
           tail -f /dev/null; \
      fi"]
